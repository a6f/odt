/dts-v1/;

/ {
    u64_cell = /bits/ 64 <1>;
    u32_cell = /bits/ 32 <2>;
    u16_cell = /bits/ 16 <3>;
    u8_cell  = /bits/  8 <4>;

    // Expressions don't depend on evaluation order
    c = <( ${a} + ${b} )>;
    a = <100>;
    b = <200>;

    array = <1 2 3>;
    empty;
    explicit-empty = <>;
    explicit-empty-2 = <>, <>;
    mixed = "one", <2>, [03], <&label_foo>, &label_foo;

    label_foo: foo {
        u32_prop = <3>;
    };
};

/ {
    check {
        absolute_ref_to_label  = <${/foo/u32_prop} 3>;
        relative_ref_to_label = <${label_foo/u32_prop} 3>;

        u64cell_test = /bits/ 64 < ${/u64_cell} >, /bits/ 64 <1>;
        u32cell_test = /bits/ 32 < ${/u32_cell} >, /bits/ 32 <2>;
        u16cell_test = /bits/ 16 < ${/u16_cell} >, /bits/ 16 <3>;
        u8cell_test  = /bits/  8 < ${/u8_cell} >,  /bits/  8 <4>;

        u64expr_test = /bits/ 64 <( ${/u64_cell} )>, /bits/ 64 <(1)>;
        u32expr_test = /bits/ 32 <( ${/u32_cell} )>, /bits/ 32 <(2)>;
        u16expr_test = /bits/ 16 <( ${/u16_cell} )>, /bits/ 16 <(3)>;
        u8expr_test  = /bits/  8 <( ${/u8_cell} )>,  /bits/  8 <(4)>;

        expr_ref_test0 = <( ${/c} + ${/a} )>, <400>;
        expr_ref_test1 = <( ${/a} * 20 )>, <2000>;
        expr_ref_test2 = <( ${/a} - 10 + ${/c} )>, <390>;

        array-ref {
            expected = <1 2 3>;
            actual = ${/array};
        };

        empty-ref {
            expected;
            actual = ${/empty};
        };

        explicit-empty-ref {
            expected;
            actual = ${/explicit-empty};
        };

        explicit-empty-2-ref {
            expected;
            actual = ${/explicit-empty-2};
        };

        mixed-ref {
            expected = "one", <2>, [03], <&label_foo>, &label_foo;
            actual = ${/mixed};
        };

        paste-refs {
            expected = <1 2 3>, "one", <2>, [03], <&label_foo>, &label_foo;
            actual = ${/array}, ${/empty}, ${/explicit-empty}, ${/explicit-empty-2}, ${/mixed};
        };
    };
};
